{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "@vercel/static-build": {
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/((?!api|sitemap.xml).*)",
      "dest": "/"
    },
    {
      "src": "/api/sitemap.xml",
      "dest": "/api/sitemap.js"
    }
  ]
}
